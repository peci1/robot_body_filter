  <url type="repository">https://github.com/ctu-vras/robot_body_filter</url>
  <url type="bugtracker">https://github.com/ctu-vras/robot_body_filter/issues</url>
  <url type="website">https://index.ros.org/p/robot_body_filter</url>

  <author>Eitan Marder-Eppstein</author>
  <author>Tomas Petricek</author>
  <author>Martin Pecka</author>
  <author>Sebastian Pelletier</author>
  <author>David V. Lu!!</author>

  <maintainer email="peckama2@fel.cvut.cz">Martin Pecka</maintainer>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>ament_cmake_gen_version_h</buildtool_depend>
  <buildtool_depend>rosidl_default_generators</buildtool_depend>

  <depend>cras_cpp_common</depend>
  <depend>eigen</depend>
  <depend>filters</depend>
  <depend>geometric_shapes</depend>
  <depend>geometry_msgs</depend>
  <depend>laser_geometry</depend>
  <depend>libpcl-all-dev</depend>
  <depend>moveit_ros_perception</depend>
  <depend>rclcpp</depend>
  <depend>rcl_interfaces</depend>
  <depend>rmw</depend>
